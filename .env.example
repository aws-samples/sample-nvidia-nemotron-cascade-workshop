# The app uses the AWS SDK default credential chain.
# Whatever makes `aws sts get-caller-identity` work makes the app work.
#
# Local dev: run `aws configure` or `aws sso login` once, then this app
# inherits the same credentials. You usually don't need anything below.

AWS_REGION=us-west-2
AWS_PROFILE=default

# Jev three-tier example only: load through your shell/MCP client's secret settings.
# Standalone tsx commands do not automatically load this file.
# AI_GATEWAY_API_KEY=

# If using temporary STS credentials, uncomment and fill these:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Optional — wire in a Bedrock Guardrail if you've created one.
# BEDROCK_GUARDRAIL_ID=
# BEDROCK_GUARDRAIL_VERSION=DRAFT
