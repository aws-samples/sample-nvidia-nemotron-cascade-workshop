{
  "name": "sample-nvidia-nemotron-cascade-workshop",
  "version": "0.1.0",
  "private": true,
  "license": "MIT-0",
  "description": "Runnable classification cascade examples: Jev on Vercel AI Gateway, Nemotron and Claude on Amazon Bedrock, with MCP tools and reproducible evaluation.",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:bakeoff": "vitest run tests/bakeoff.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "bakeoff": "tsx scripts/bakeoff.ts",
    "compare:three-tier": "tsx scripts/compare-three-tier.ts",
    "compare:three-tier:collect": "node --import tsx --import ./scripts/gateway-rate-limit.mjs scripts/compare-three-tier.ts --collect-jev && node scripts/summarize-three-tier.mjs",
    "compare:three-tier:report": "node scripts/summarize-three-tier.mjs",
    "audit:three-tier": "tsx scripts/audit-three-tier.ts",
    "triage:three-tier": "tsx scripts/triage-three-tier.ts",
    "mcp": "tsx mcp/server.ts",
    "generate-agent-review": "tsx scripts/generate-agent-review-packet.ts",
    "generate-tickets": "tsx scripts/generate-tickets.ts",
    "validate-agent-review": "tsx scripts/validate-agent-review-results.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "next": "^16.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock": "^3.1044.0",
    "@aws-sdk/credential-providers": "^3.1044.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^22.9.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "msw": "^2.6.5",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.22.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.4"
  }
}
